<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        深色 + 无标题栏的主题（Compose 里还会再套一层 ChessClockTheme）。
        windowBackground 用深色，避免冷启动时闪白。
    -->
    <style name="Theme.ChessClock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/clock_background</item>
        <item name="android:colorBackground">@color/clock_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
    </style>

</resources>
